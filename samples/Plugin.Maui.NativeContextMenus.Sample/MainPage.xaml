<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Plugin.Maui.NativeContextMenus;assembly=Plugin.Maui.NativeContextMenus"
             x:Class="Plugin.Maui.NativeContextMenus.Sample.MainPage"
             Title="Native Context Menus Sample">

    <ContentPage.ToolbarItems>

        <!-- Inline XAML Menu Example -->
        <local:NativeContextMenuToolbarItem Text="Actions">

            <!-- Simple refresh action -->
            <local:MenuNode Title="Refresh" Command="{Binding RefreshCommand}" />
            
            <!-- View mode radio group. SelectedValue holds the Value of the checked item. -->
            <local:MenuNode Title="View Mode" SelectedValue="{Binding CurrentViewMode}">
                <local:MenuNode Title="List" Value="List" />
                <local:MenuNode Title="Grid" Value="Grid" />
                <local:MenuNode Title="Card" Value="Card" />
            </local:MenuNode>

            <!-- Radio group for an enum property. Value is text, and the view model gets the enum value. -->
            <local:MenuNode Title="Density" SelectedValue="{Binding Density}">
                <local:MenuNode Title="Compact" Value="Compact" />
                <local:MenuNode Title="Regular" Value="Regular" />
                <local:MenuNode Title="Large" Value="Large" />
            </local:MenuNode>

            <!-- Radio group for an int property -->
            <local:MenuNode Title="Page Size" SelectedValue="{Binding PageSize}">
                <local:MenuNode Title="25" Value="25" />
                <local:MenuNode Title="50" Value="50" />
                <local:MenuNode Title="100" Value="100" />
            </local:MenuNode>
            
            <!-- Simple action -->
            <local:MenuNode Title="Add Item" Command="{Binding AddItemCommand}" />
            
            <!-- Destructive action. It shows only when there are items. -->
            <local:MenuNode Title="Clear All" Destructive="True" Command="{Binding ClearCommand}"
                           IsVisible="{Binding HasItems}" />
            
        </local:NativeContextMenuToolbarItem>
        
        <!-- MVVM Binding Menu Example -->
        <local:NativeContextMenuToolbarItem Text="Filters"
                                           ItemsSource="{Binding MenuItems}" />

    </ContentPage.ToolbarItems>

    <ScrollView Padding="20">
        <StackLayout Spacing="20">
            
            <!-- Header -->
            <Label Text="Native Context Menus Demo" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            
            <Label Text="This sample demonstrates both inline XAML and MVVM binding approaches for native toolbar context menus."
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            
            <!-- Status Section -->
            <Frame BackgroundColor="LightBlue" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Current Status" FontAttributes="Bold" />
                    <Label Text="{Binding StatusText}" FontSize="16" />
                </StackLayout>
            </Frame>
            
            <!-- Current Settings -->
            <Frame BackgroundColor="LightGreen" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Current Settings" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                        
                        <Label Grid.Row="0" Grid.Column="0" Text="View Mode:" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CurrentViewMode}" />
                        
                        <Label Grid.Row="1" Grid.Column="0" Text="Sort Mode:" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentSortMode}" />
                        
                        <Label Grid.Row="2" Grid.Column="0" Text="Item Count:" FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ItemCount}" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Density:" FontAttributes="Bold" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Density}" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Page Size:" FontAttributes="Bold" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding PageSize}" />
                        
                    </Grid>
                </StackLayout>
            </Frame>
            
            <!-- Instructions -->
            <Frame BackgroundColor="LightYellow" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Instructions" FontAttributes="Bold" />
                    <Label Text="• Tap the 'Actions' toolbar button to see inline XAML menu" />
                    <Label Text="• Tap the 'Filters' toolbar button to see MVVM binding menu" />
                    <Label Text="• Try the radio groups (View Mode, Sort By, Filters)" />
                    <Label Text="• Notice instant-apply behavior - no 'Apply' button needed" />
                    <Label Text="• Watch the status updates when you interact with menus" />
                </StackLayout>
            </Frame>

            <!-- Platform Notes -->
            <Frame BackgroundColor="LightCoral" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Platform Notes" FontAttributes="Bold" />
                    <Label Text="• iOS and Mac Catalyst: the UIMenu of the bar button" />
                    <Label Text="• Android: a PopupMenu anchored to the toolbar button" />
                </StackLayout>
            </Frame>
            
        </StackLayout>
    </ScrollView>

</ContentPage>
