<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Plugin.Maui.NativeContextMenus.Sample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Plugin.Maui.NativeContextMenus.Sample"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Context Menu"
            ContentTemplate="{DataTemplate pages:ContextMenuPage}" />

        <ShellContent
            Title="Toolbar Menu"
            ContentTemplate="{DataTemplate pages:MainPage}" />
    </TabBar>

</Shell>
